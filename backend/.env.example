#  Server 
PORT=4000
# Comma-separated list of origins allowed to call the API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

#  Database 
# Local mongosh / community server on your PC:
MONGO_URI=mongodb://127.0.0.1:27017/smart_canteen
# When you switch to MongoDB Compass / Atlas later, just paste the connection
# string here instead, e.g.:
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/smart_canteen

#  Auth 
# Change this to a long random string in production.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES=7d

#  Canteen / mess identity 
MESS_NAME=SkipLine

#  Points / wallet rules 
# Points (equivalent to Rs) credited to every student at the start of a month.
MONTHLY_ALLOWANCE=8000
# Maximum a student can spend in a single day.
DAILY_LIMIT=450
# Password given to students created via Excel upload if the sheet has no
# Password column. Students are forced to reset it on first login.
DEFAULT_STUDENT_PASSWORD=canteen@123

#  Seed admin (mess owner) 
# Used only by `npm run seed` to create the first admin account.
ADMIN_NAME=Mess Owner
ADMIN_LOGIN=admin
ADMIN_EMAIL=owner@srccdx.local
ADMIN_PASSWORD=admin@123
